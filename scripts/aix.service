[Unit]
Description=AIX backend
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/aix
ExecStart=/opt/aix/bin/server -conf /opt/aix/configs
Restart=always
RestartSec=3
LimitNOFILE=65535
Environment=GOMAXPROCS=1
StandardOutput=append:/opt/aix/logs/backend.out.log
StandardError=append:/opt/aix/logs/backend.err.log

[Install]
WantedBy=multi-user.target
