# API 代理目标（vite dev server）
VITE_PROXY_TARGET=https://aixai.pro
VITE_API=

# 预览用注入钱包：无 MetaMask 环境下也能走完登录签名。生产构建请设为 false
VITE_DEV_WALLET=true
# 可选：指定固定私钥（留空则自动生成并存入 localStorage，刷新后地址不变）
VITE_DEV_WALLET_PK=

# 预览用离线 Mock：拦截 /v1/* 返回模拟数据，绕过邀请码/后端。生产构建请设为 false
VITE_DEV_MOCK=true

# EOEO 链（WIN 充值）
VITE_CHAINID=86233268
VITE_RPC_URL=https://rpc1.eoeo.info

# BSC 链（USDT 充值）
VITE_BSC_CHAINID=56
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org

# USDT 充值合约（ERC-20 buy）
VITE_BUY_USDT=0xa5A438Bb1D0F702c684B4d7bAAE2C520aFb4aE86

# WIN 原生充值合约（payable buy）
VITE_BUY=0x94db6bb040107ef9a2F1e9DB9d84dD8D6D98997e

# WIN-A 充值合约（BuySomething）
VITE_BUY_WIN_A=0xcaa39A8E23F5548AD85d9e2B9B21F63E99505040

# USDT ERC-20 合约
VITE_USDT=0x926632975149221891f1b9B56Efd125Dfe90ba2f

# AIX-USDT 代币合约（积分提现链上代币）
VITE_AIX_USDT_CONTRACT=0x314D550572a0fA001B465a9EBc1dd04D834a0688
